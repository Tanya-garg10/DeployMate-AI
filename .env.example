# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ZEROPS_API_TOKEN: Optional Zerops API token for live deployments (falls back to simulation mode if not provided)
ZEROPS_API_TOKEN=""

# GITHUB_TOKEN: Optional GitHub Personal Access Token for higher rate limits on GitHub API repo inspection
GITHUB_TOKEN=""
